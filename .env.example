# Required for `ask`: free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown)
# LLM_MODEL=openai/gpt-oss-20b
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# QDRANT_URL=                 # e.g. http://localhost:6333; empty = embedded local mode
# QDRANT_PATH=./qdrant_data
# QDRANT_COLLECTION=documents
# TOP_K=5
# SCORE_THRESHOLD=0.2         # min cosine similarity; tune with `structure-rag search`
